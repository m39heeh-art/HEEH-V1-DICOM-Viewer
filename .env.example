# Copy this file to .env and adjust values for your environment.
# All values are optional; the application runs without a .env file.

# Streamlit server settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Optional: Hugging Face token (only needed if you download private models)
# HF_TOKEN=

# Optional: disable streamlit telemetry
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# Generate with:
# python -c "from core.security import generate_key; print(generate_key())"
# Store this only in a secret manager or protected environment variable.
NEUROPROJECT_ENCRYPTION_KEY=
